{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "perfect-playlist-scroll-preview",
  "main": "./worker.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  }
}
